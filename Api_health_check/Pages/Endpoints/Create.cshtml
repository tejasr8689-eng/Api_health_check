@page
@model Api_health_check.Pages.Endpoints.CreateModel
@{
    ViewData["Title"] = "Add Endpoint";
}

<h1>Add Endpoint</h1>

<form method="post">
    <div class="mb-3">
        <label asp-for="Endpoint.Name" class="form-label"></label>
        <input asp-for="Endpoint.Name" class="form-control" />
        <span asp-validation-for="Endpoint.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Endpoint.Url" class="form-label"></label>
        <input asp-for="Endpoint.Url" class="form-control" />
        <span asp-validation-for="Endpoint.Url" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Endpoint.CheckIntervalSeconds" class="form-label"></label>
        <input asp-for="Endpoint.CheckIntervalSeconds" class="form-control" />
        <span asp-validation-for="Endpoint.CheckIntervalSeconds" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Endpoint.NotifyEmail" class="form-label"></label>
        <input asp-for="Endpoint.NotifyEmail" class="form-control" />
        <span asp-validation-for="Endpoint.NotifyEmail" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Endpoint.AppPoolName" class="form-label"></label>
        <input asp-for="Endpoint.AppPoolName" class="form-control" />
        <span asp-validation-for="Endpoint.AppPoolName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Endpoint.RecoveryWebhookUrl" class="form-label"></label>
        <input asp-for="Endpoint.RecoveryWebhookUrl" class="form-control" />
        <span asp-validation-for="Endpoint.RecoveryWebhookUrl" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Endpoint.IsActive" class="form-check-input" />
        <label asp-for="Endpoint.IsActive" class="form-check-label"></label>
    </div>
    <div class="from-group">
        <label asp-for="Endpoint.RecoveryAction" class="form-label"></label>
        <select asp-for="Endpoint.RecoveryAction" class="form-select" asp-items="Model.RecoveryAction">
          @*   <option value="">Restart AppPool</option> *@
            <@* option value="1">StartWebsite</option>
            <option value="2">RestartWebsite</option>
            <option value="3">FullRecovery</option> *@


        </select>
        <span asp-validation-for="Endpoint.RecoveryAction" class="text-danger">Full Recovery Recomended</span>
    </div> 

    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
