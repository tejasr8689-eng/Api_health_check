@page
@model Api_health_check.Pages.Endpoints.DeleteModel

<h2>Delete Endpoint</h2>

<h4>Are you sure you want to delete this endpoint?</h4>

<div>
    <strong>Name:</strong> @Model.Endpoint.Name <br />
    <strong>URL:</strong> @Model.Endpoint.Url
</div>

<form method="post">
    <input type="hidden" asp-for="Endpoint.Id" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-page="/Index" class="btn btn-secondary">
        Cancel
    </a>
</form>
