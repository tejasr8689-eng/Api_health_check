@page
@model Api_health_check.Pages.Endpoints.Index
@{
    ViewData["Title"] = "Health Dashboard";
}

<h1>Health Dashboard</h1>

<p>
    <a asp-page="/Endpoints/Create" class="btn btn-primary">Add Endpoint</a>
</p>

<table class="table table-hover align-middle ">
    <thead>
        <tr>
            <th class="text-center">Name</th>
            <th class="text-center">Url</th>
            <th class="text-center">Last Status</th>
            <th class="text-center">Is Down</th>
            <th class="text-center">Last Check (UTC)</th>
            <th class="text-center">Failures</th>
            <th class="align-content-center">App  Pool Name</th>
            <th class="text-center">RecoveryWebHook URL</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model.Endpoints)
        {
            var rowClass = e.IsDown ? "table-danger" : "table-success";
            <tr class="@rowClass">
                <td>@e.Name</td>
                <td>@e.Url</td>
                <td>@(e.LastStatusCode?.ToString() ?? "-")</td>
                <td>@e.IsDown</td>
                <td>@(e.LastCheckUtc?.ToString("u") ?? "-")</td>
                <td>@e.ConsecutiveFailures</td>
                <td>@e.AppPoolName</td>
                <td>@e.RecoveryWebhookUrl</td>
                <td>
                    <div class="d-flex justify-content-center gap-2">
                             <a asp-page="/Endpoints/Edit" asp-route-id="@e.Id" class="btn btn-primary btn-sm"> <i class="bi bi-pencil-square"></i></a>
              
                              <a asp-page="/Endpoints/Delete" asp-route-id="@e.Id" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i></a>
                    </div>
                </td>
                
                
            </tr>
        }
    </tbody>
</table>
